---
import '../styles/global.css';
import DraglineSpider from '../components/DraglineSpider.astro';

interface Props {
  title: string;
  description?: string;
  /** Quick-log is a focused screen — it hides the site chrome. */
  bare?: boolean;
  /**
   * Keeps a page out of search results. The tracker and quick-log screens have
   * nothing useful to index — they are an empty shell until the visitor's own
   * local data loads — and indexing them would just produce blank results.
   */
  noindex?: boolean;
  /** Optional JSON-LD structured data for this page. */
  schema?: Record<string, unknown>;
}

const {
  title,
  description = 'An open jumping spider care reference, with a private feeding and molt tracker that runs entirely on your own device.',
  bare = false,
  noindex = false,
  schema,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;

/** Single source of truth for the repo link, used in the footer and on /about. */
export const REPO_URL = 'https://github.com/evelynAnais/spoodHub';

const nav = [
  { href: '/species', label: 'Species' },
  { href: '/care', label: 'Care' },
  { href: '/track', label: 'Tracker' },
  { href: '/about', label: 'About' },
];

const path = Astro.url.pathname;
const isHome = path === '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#12100f" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="spoodHub" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:site_name" content="spoodHub" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {/* Astro hints that this should carry `is:inline`, but directives are not
        allowed inside an expression block. Left off deliberately: Astro only
        processes untyped and module scripts, so JSON-LD passes through
        untouched either way. */}
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body class="bg-bg text-fg antialiased">
    {
      !bare && (
        <header class="border-b border-line">
          <nav class="mx-auto flex max-w-5xl items-center gap-1 px-4 py-3">
            {/* `relative` so the spider can hang from the wordmark. It is
                landing-page only — see DraglineSpider for why. */}
            <span class="relative mr-auto">
              <a href="/" class="text-lg font-bold tracking-tight">
                spood<span class="text-accent">Hub</span>
              </a>
              {isHome && <DraglineSpider />}
            </span>
            {nav.map((item) => (
              <a
                href={item.href}
                class:list={[
                  'rounded-lg px-3 py-1.5 text-sm font-medium transition',
                  path.startsWith(item.href)
                    ? 'bg-raised text-fg'
                    : 'text-muted hover:text-fg',
                ]}
              >
                {item.label}
              </a>
            ))}
          </nav>
        </header>
      )
    }

    <main class="mx-auto max-w-5xl px-4 py-8">
      <slot />
    </main>

    {
      !bare && (
        <footer class="mt-16 border-t border-line">
          <div class="mx-auto max-w-5xl px-4 py-8 text-sm text-muted">
            <p>
              Care information here is contributed by keepers and is not veterinary advice. Found
              something wrong?{' '}
              <a href="/about#contributing" class="text-accent hover:underline">
                Open a pull request
              </a>
              .
            </p>
            <p class="mt-2">
              Your tracker data never leaves your device.{' '}
              <a href="/about#how-the-tracker-works" class="text-accent hover:underline">
                How that works
              </a>
              .
            </p>
            <p class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2">
              <a
                href={REPO_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 text-accent hover:underline"
              >
                <svg
                  viewBox="0 0 16 16"
                  aria-hidden="true"
                  class="size-4 fill-current"
                >
                  <path
                    d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
                  />
                </svg>
                Source on GitHub
              </a>
              <a
                href={`${REPO_URL}/blob/main/CONTRIBUTING.md`}
                target="_blank"
                rel="noopener noreferrer"
                class="text-accent hover:underline"
              >
                Contributing guide
              </a>
              <a
                href={`${REPO_URL}/issues/new`}
                target="_blank"
                rel="noopener noreferrer"
                class="text-accent hover:underline"
              >
                Report a problem
              </a>
            </p>
          </div>
        </footer>
      )
    }

    <script>
      // Registers the offline cache. Failure here is not worth surfacing —
      // the site works fine without it, just not offline.
      //
      // Skipped in dev: localhost shares an origin with nothing else, so a
      // service worker registered while developing keeps serving cached pages
      // after `astro dev` stops, which looks exactly like a server that will
      // not die. Offline still works in `npm run preview` and in production.
      if ('serviceWorker' in navigator && import.meta.env.PROD) {
        addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
  </body>
</html>
