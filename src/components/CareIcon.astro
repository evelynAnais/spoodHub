---
/**
 * A small line icon per care topic, drawn inline so it inherits the current
 * text colour and needs no asset pipeline or dependency.
 *
 * Matched on slug, with a deliberate fallback: a new guide gets the generic
 * jumping-spider-eyes mark rather than failing or rendering a gap, so nobody
 * has to add an icon before their contribution looks finished.
 */

interface Props {
  slug: string;
  class?: string;
}

const { slug, class: className = '' } = Astro.props;

// Each entry is the inner markup of a 24×24 viewBox, stroked with currentColor.
const ICONS: Record<string, string> = {
  // A tall vertical enclosure with a vented lid and an anchor point up high.
  'enclosure-setup': `
    <rect x="5" y="3" width="14" height="18" rx="2"/>
    <path d="M5 6h14"/>
    <path d="M8 4.5h.01M11 4.5h.01M14 4.5h.01M16.5 4.5h.01"/>
    <path d="M9 9c2.5 1 4 3 4.5 5.5"/>
    <path d="M15 8.5v3"/>`,
  // A fly: body plus wings.
  feeding: `
    <ellipse cx="12" cy="14" rx="2.6" ry="4"/>
    <path d="M9.6 11C7 8.5 4 8.8 3.5 10.5 3 12.2 6 13.4 9.2 12.6"/>
    <path d="M14.4 11c2.6-2.5 5.6-2.2 6.1-.5.5 1.7-2.5 2.9-5.7 2.1"/>
    <path d="M11 10.4l-.8-2M13 10.4l.8-2"/>`,
  // A shed exoskeleton beside the spider that left it.
  molting: `
    <ellipse cx="8" cy="12" rx="3.2" ry="4.2"/>
    <ellipse cx="16" cy="12" rx="3.2" ry="4.2" stroke-dasharray="2 2"/>
    <path d="M5 9.5L3 8M5 14.5L3 16M11 9.5l1.5-1M11 14.5l1.5 1"/>`,
  // Female and male symbols, the thing the guide is actually about.
  sexing: `
    <circle cx="8" cy="9" r="3.2"/>
    <path d="M8 12.2V19M6 16.5h4"/>
    <circle cx="16" cy="15" r="3.2"/>
    <path d="M18.3 12.7L21.5 9.5M18 9.5h3.5V13"/>`,
  // The salticid giveaway: two big forward eyes.
  'behavior-and-body-language': `
    <circle cx="9" cy="12" r="4"/>
    <circle cx="17.5" cy="11" r="2.4"/>
    <circle cx="9" cy="12" r="1.4" fill="currentColor" stroke="none"/>
    <circle cx="17.5" cy="11" r="0.9" fill="currentColor" stroke="none"/>
    <path d="M3.5 8.5C4.5 7 6 6.2 7.5 6"/>`,
  // A round sac with eggs inside.
  'egg-sacs': `
    <path d="M12 4c4 0 7 3.4 7 7.5S16 20 12 20s-7-4.4-7-8.5S8 4 12 4z"/>
    <circle cx="10" cy="11" r="1.1" fill="currentColor" stroke="none"/>
    <circle cx="13.6" cy="10.4" r="1.1" fill="currentColor" stroke="none"/>
    <circle cx="12" cy="14" r="1.1" fill="currentColor" stroke="none"/>`,
  // A moon, plus the curled legs of a resting spider.
  'sleep-and-rest': `
    <path d="M19 14.5A7.5 7.5 0 019.5 5a7.5 7.5 0 109.5 9.5z"/>
    <path d="M4 18.5c1-.8 2-.8 3 0M4.5 21c1-.8 2-.8 3 0"/>`,
  // Nested outlines: the same spider at successive instars.
  'age-and-instars': `
    <ellipse cx="12" cy="12" rx="2.2" ry="2.8"/>
    <ellipse cx="12" cy="12" rx="4.6" ry="5.6" stroke-dasharray="3 2"/>
    <ellipse cx="12" cy="12" rx="7" ry="8.4" stroke-dasharray="2 3"/>`,
};

const FALLBACK = `
  <circle cx="9.5" cy="12" r="3.6"/>
  <circle cx="16" cy="11" r="2.2"/>
  <circle cx="9.5" cy="12" r="1.2" fill="currentColor" stroke="none"/>
  <circle cx="16" cy="11" r="0.8" fill="currentColor" stroke="none"/>`;

const markup = ICONS[slug] ?? FALLBACK;
---

<svg
  viewBox="0 0 24 24"
  aria-hidden="true"
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  set:html={markup}
/>
