---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Photo {
  src: ImageMetadata;
  alt: string;
  credit: string;
  license: string;
  sourceUrl: string;
}

interface Props {
  images?: { female?: Photo; male?: Photo };
  commonName: string;
}

const { images, commonName } = Astro.props;

const panels = [
  { label: 'Female', photo: images?.female },
  { label: 'Male', photo: images?.male },
];

const anyPhoto = panels.some((p) => p.photo);
---

<section class="mt-8">
  <div class="grid gap-4 sm:grid-cols-2">
    {
      panels.map(({ label, photo }) => (
        <figure class="overflow-hidden rounded-xl border border-line bg-surface">
          {photo ? (
            <Image
              src={photo.src}
              alt={photo.alt}
              widths={[400, 800]}
              sizes="(min-width: 640px) 50vw, 100vw"
              class="aspect-[4/3] w-full object-cover"
            />
          ) : (
            /* Deliberately not hidden. A visible gap is a standing request for
               a photo; silently omitting the panel would make the absence
               invisible and nobody would ever fill it. */
            <div class="flex aspect-[4/3] w-full items-center justify-center bg-raised px-4 text-center">
              <p class="text-sm text-muted">
                No {label.toLowerCase()} photo yet
                <span class="mt-1 block text-xs">
                  Contributions welcome — see the contributing guide
                </span>
              </p>
            </div>
          )}

          <figcaption class="border-t border-line px-3 py-2">
            <div class="flex flex-wrap items-baseline justify-between gap-x-2">
              <span class="text-sm font-medium">
                {label} {commonName.toLowerCase()}
              </span>
              {photo && (
                <span class="text-xs text-muted">
                  {photo.credit} ·{' '}
                  <a
                    href={photo.sourceUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hover:underline"
                  >
                    {photo.license}
                  </a>
                </span>
              )}
            </div>
          </figcaption>
        </figure>
      ))
    }
  </div>

  {
    !anyPhoto && (
      <p class="mt-3 text-xs text-muted">
        Jumping spiders are often strikingly different between the sexes, so photos of both do
        more for identification here than any description can.
      </p>
    )
  }
</section>
