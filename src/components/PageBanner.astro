---
import { Image } from 'astro:assets';
import { speciesShots } from '../lib/species-shots';

interface Props {
  /** Sits over the image, so it needs to survive a busy photo behind it. */
  title: string;
  subtitle?: string;
  /** Shorter, for pages people open to do something rather than to read. */
  compact?: boolean;
}

const { title, subtitle, compact = false } = Astro.props;

/**
 * A short banner for pages that are otherwise all prose.
 *
 * Deliberately wide and shallow rather than a hero: these pages exist to be
 * read, and a tall image would just push the text down. It also reuses photos
 * already in the repo instead of introducing decorative stock art.
 *
 * Build-time shuffled, like the other treatments, so the landing page and this
 * one are not always showing the same spider.
 */
const [shot] = await speciesShots(1);
---

<header class="relative -mx-4 mb-8 overflow-hidden sm:mx-0 sm:rounded-2xl">
  {
    shot && (
      <Image
        src={shot.photo.src}
        alt=""
        widths={[640, 1280]}
        sizes="(min-width: 1024px) 64rem, 100vw"
        class:list={["w-full object-cover", compact ? "h-24 sm:h-28" : "h-36 sm:h-44"]}
      />
    )
  }

  {/* Two layers: a gradient for legibility over the busy parts of a macro
      photo, and a flat tint so pale images cannot wash the text out. */}
  <div class="absolute inset-0 bg-black/35"></div>
  <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/40 to-transparent"></div>

  <div class="absolute inset-x-0 bottom-0 p-4 sm:p-6">
    <h1 class:list={["font-bold text-white drop-shadow-sm", compact ? "text-2xl" : "text-3xl"]}>{title}</h1>
    {subtitle && <p class="mt-1 max-w-2xl text-sm text-white/80">{subtitle}</p>}
  </div>

  {
    shot && (
      <a
        href={`/species/${shot.slug}`}
        class="absolute top-2 right-2 rounded-full bg-black/50 px-2.5 py-1 text-[11px] text-white/80 backdrop-blur-sm transition hover:text-white"
      >
        {shot.commonName} · {shot.photo.credit} ({shot.photo.license})
      </a>
    )
  }
</header>
