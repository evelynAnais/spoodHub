---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import CareIcon from '../../components/CareIcon.astro';
import SpeciesMarquee from '../../components/hero/SpeciesMarquee.astro';
import PageBanner from '../../components/PageBanner.astro';
import Base from '../../layouts/Base.astro';

const species = (await getCollection('species')).sort((a, b) =>
  a.data.commonName.localeCompare(b.data.commonName),
);

const DIFFICULTY_TONE = {
  beginner: 'bg-ok/10 text-ok border-ok/30',
  intermediate: 'bg-watch/10 text-watch border-watch/30',
  advanced: 'bg-alert/10 text-alert border-alert/30',
} as const;
---

<Base title="Species — spoodHub" description="Care profiles for commonly kept jumping spiders.">
  <PageBanner
    title="Species"
    subtitle="Profiles for jumping spiders commonly kept as pets. Every page is a Markdown file in the repository — corrections and new species are welcome."
  />

  {/*
    The classification link previews its own contents rather than describing
    them: the taxonomic chain is the thing that page teaches, so showing it
    here does the decorating and the explaining at once. A reader who already
    knows what Salticidae means can skip it on sight — which a generic
    "learn more" card never lets them do.
  */}
  <a
    href="/classification"
    class="group block rounded-2xl border border-accent/30 bg-accent/5 p-5 transition hover:border-accent/60 sm:p-6"
  >
    <div class="flex items-start gap-4">
      <div class="min-w-0 flex-1">
        <p class="text-xs font-semibold tracking-widest text-accent uppercase">New to this?</p>
        <h2 class="mt-0.5 text-lg font-semibold">Where jumping spiders fit</h2>

        <ol class="mt-3 flex flex-wrap items-center gap-x-1.5 gap-y-1.5 text-xs">
          {
            [
              { name: 'Arthropoda', note: 'phylum' },
              { name: 'Arachnida', note: 'class' },
              { name: 'Araneae', note: 'order' },
              { name: 'Salticidae', note: 'family' },
              { name: 'Phidippus', note: 'genus' },
            ].map((step, i) => (
              <>
                {i > 0 && (
                  <li class="text-muted" aria-hidden="true">
                    ›
                  </li>
                )}
                <li
                  class="rounded-full border border-line bg-surface px-2.5 py-1 transition group-hover:border-accent/40"
                  title={step.note}
                >
                  {step.name}
                </li>
              </>
            ))
          }
        </ol>

        <p class="mt-3 text-sm text-muted">
          Why a spider is not an insect or a bug, what the two-part Latin names mean, how
          tarantulas differ, and how the species below relate to each other.
        </p>
      </div>

      <span class="grid size-11 shrink-0 place-items-center rounded-full border border-accent/30 bg-bg text-accent transition group-hover:border-accent/60">
        <CareIcon slug="__eyes" class="size-6" />
      </span>
    </div>
  </a>

  <SpeciesMarquee />

  <ul class="mt-8 grid gap-4 sm:grid-cols-2">
    {
      species.map((entry) => (
        <li>
          <a
            href={`/species/${entry.id}`}
            class="block h-full rounded-xl border border-line bg-surface p-5 transition hover:border-accent/50"
          >
            <div class="flex items-start gap-3">
              {
                /*
                  The profile's own photo, rather than generic art. Female by
                  preference since she is usually the more familiar form, but
                  falling back to the male — and the thumbnail always says which
                  it is showing.

                  That label is not decoration. Jumping spiders are dramatically
                  dimorphic; an unlabelled male regal thumbnail would give a
                  browsing reader entirely the wrong idea of the species, on a
                  site whose sexing guide exists to tell them apart.
                */
                (() => {
                  const female = entry.data.images?.female;
                  const thumb = female ?? entry.data.images?.male;
                  const sex = female ? 'Female' : 'Male';
                  return thumb ? (
                    <span class="relative shrink-0">
                      <Image
                        src={thumb.src}
                        alt=""
                        widths={[96, 192]}
                        sizes="72px"
                        class="size-16 rounded-xl object-cover"
                      />
                      <span
                        class="absolute -right-1 -bottom-1 grid size-5 place-items-center rounded-full border border-line bg-surface text-[11px] leading-none text-muted"
                        title={`${sex} pictured`}
                      >
                        <span aria-hidden="true">{female ? '♀' : '♂'}</span>
                        <span class="sr-only">{sex} pictured</span>
                      </span>
                    </span>
                  ) : (
                    <span class="grid size-16 shrink-0 place-items-center rounded-xl border border-line bg-raised text-muted">
                      <CareIcon slug="__species" class="size-7" />
                    </span>
                  );
                })()
              }
              <div class="min-w-0 flex-1">
                <h2 class="font-semibold">{entry.data.commonName}</h2>
                <p class="text-sm italic text-muted">{entry.data.scientificName}</p>
              </div>
              <span
                class:list={[
                  'shrink-0 rounded-full border px-2.5 py-0.5 text-xs font-medium capitalize',
                  entry.data.difficulty
                    ? DIFFICULTY_TONE[entry.data.difficulty]
                    : 'border-line bg-raised text-muted',
                ]}
              >
                {entry.data.difficulty ?? 'care undocumented'}
              </span>
            </div>

            <dl class="mt-4 grid grid-cols-2 gap-x-4 gap-y-2 text-sm">
              <div>
                <dt class="text-xs text-muted">Adult female</dt>
                <dd>{entry.data.adultSize?.female ?? '—'}</dd>
              </div>
              <div>
                <dt class="text-xs text-muted">Temperament</dt>
                <dd class="capitalize">{entry.data.temperament ?? '—'}</dd>
              </div>
              <div>
                <dt class="text-xs text-muted">Temperature</dt>
                <dd>
                  {
                    entry.data.temperatureC
                      ? `${entry.data.temperatureC.min}–${entry.data.temperatureC.max} °C`
                      : '—'
                  }
                </dd>
              </div>
              <div>
                <dt class="text-xs text-muted">Humidity</dt>
                <dd>
                  {
                    entry.data.humidityPct
                      ? `${entry.data.humidityPct.min}–${entry.data.humidityPct.max}%`
                      : '—'
                  }
                </dd>
              </div>
            </dl>
          </a>
        </li>
      ))
    }
  </ul>
</Base>
