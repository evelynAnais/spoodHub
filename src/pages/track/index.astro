---
import { getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import TrackerApp from '../../components/tracker/TrackerApp';
import PageBanner from '../../components/PageBanner.astro';
import Base from '../../layouts/Base.astro';
import type { SpeciesOption } from '../../lib/species';

/**
 * The species list is resolved at build time and handed to the island as a
 * prop, so the client bundle never has to know about content collections.
 *
 * Thumbnails are resolved here too. The island is `client:only`, so it cannot
 * use Astro's <Image> component — `getImage()` gives it a plain optimised URL
 * to drop into an <img> instead.
 */
const entries = (await getCollection('species')).sort((a, b) =>
  a.data.commonName.localeCompare(b.data.commonName),
);

const speciesOptions: SpeciesOption[] = await Promise.all(
  entries.map(async (entry) => {
    const photo = entry.data.images?.female ?? entry.data.images?.male;
    const thumb = photo
      ? (await getImage({ src: photo.src, width: 96, height: 96, format: 'webp' })).src
      : undefined;

    return {
      slug: entry.id,
      commonName: entry.data.commonName,
      scientificName: entry.data.scientificName,
      typicalMoltIntervalDays: entry.data.typicalMoltIntervalDays,
      thumb,
    };
  }),
);
---

<Base
  title="Tracker — spoodHub"
  noindex
  description="Track feedings, molts and behavior for your jumping spiders. Stored on your device."
>
  <PageBanner
    compact
    title="Tracker"
    subtitle="Stored on this device, never uploaded."
  />

  {/*
    client:only because every byte this component renders comes from IndexedDB,
    which does not exist during the build. There is nothing to pre-render.
  */}
  <TrackerApp speciesOptions={speciesOptions} client:only="react">
    <p slot="fallback" class="py-12 text-center text-muted">Loading your log…</p>
  </TrackerApp>
</Base>
