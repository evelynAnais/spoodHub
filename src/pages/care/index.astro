---
import { getCollection } from 'astro:content';
import CareIcon from '../../components/CareIcon.astro';
import Base from '../../layouts/Base.astro';

const care = (await getCollection('care')).sort((a, b) => a.data.order - b.data.order);
---

<Base title="Care guides — spoodHub" description="Practical husbandry guides for jumping spiders.">
  <h1 class="text-3xl font-bold">Care guides</h1>
  <p class="mt-2 max-w-2xl text-muted">
    The practical side: enclosures, feeding, molting, and what to do when something looks wrong.
  </p>

  <ul class="mt-8 space-y-3">
    {
      care.map((entry) => (
        <li>
          <a
            href={`/care/${entry.id}`}
            class="group flex items-start gap-4 rounded-xl border border-line bg-surface p-5 transition hover:border-accent/50"
          >
            <span class="grid size-12 shrink-0 place-items-center rounded-xl border border-line bg-raised text-muted transition group-hover:border-accent/40 group-hover:text-accent">
              <CareIcon slug={entry.id} class="size-6" />
            </span>

            <span class="min-w-0 flex-1">
              <h2 class="font-semibold">{entry.data.title}</h2>
              <p class="mt-1 text-sm text-muted">{entry.data.summary}</p>
              {entry.data.tags.length > 0 && (
                <span class="mt-3 flex flex-wrap gap-1.5">
                  {entry.data.tags.map((tag) => (
                    <span class="rounded-full border border-line bg-raised px-2 py-0.5 text-xs text-muted">
                      {tag}
                    </span>
                  ))}
                </span>
              )}
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</Base>
