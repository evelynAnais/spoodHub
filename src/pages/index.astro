---
import { getCollection } from 'astro:content';
import SpeciesShowcase from '../components/hero/SpeciesShowcase.astro';
import Base from '../layouts/Base.astro';

const species = (await getCollection('species')).sort((a, b) =>
  a.data.commonName.localeCompare(b.data.commonName),
);
const care = (await getCollection('care')).sort((a, b) => a.data.order - b.data.order);
---

<Base title="spoodHub — jumping spider care & tracking">
  {/*
    Three separate grid children rather than a text column plus an image.
    On mobile the source order is what shows: heading, photo, buttons — so the
    photo sits under the text instead of pushing it off the first screen, and
    the call to action stays directly reachable below it.

    From `lg` up they are placed explicitly: text and buttons stack in column
    one, the photo occupies column two across both rows.
  */}
  {/* No top padding: <main> already supplies py-8, and adding more here made
      the landing heading sit twice as far from the header as every other
      page's. A little extra breathing room is fine from lg up. */}
  <section class="grid gap-x-8 gap-y-6 pb-2 lg:grid-cols-[1fr_22rem] lg:items-center lg:pt-4 lg:pb-8">
    <div class="lg:col-start-1 lg:row-start-1 lg:self-end">
      <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
        Everything about your <span class="text-accent">jumping spiders</span>, in one place.
      </h1>
      <p class="mt-4 max-w-2xl text-lg text-muted">
        An open care reference anyone can improve, plus a feeding and molt tracker that runs
        entirely on your own device — no account, no server, works offline.
      </p>
    </div>

    <div class="lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:self-center">
      <SpeciesShowcase />
    </div>

    <div class="flex flex-wrap gap-3 lg:col-start-1 lg:row-start-2 lg:self-start">
      <a
        href="/track"
        class="rounded-lg bg-accent px-5 py-2.5 font-medium text-accent-fg transition hover:opacity-90"
      >
        Open the tracker
      </a>
      <a
        href="/species"
        class="rounded-lg border border-line bg-raised px-5 py-2.5 font-medium transition hover:border-accent/50"
      >
        Browse species
      </a>
    </div>
  </section>

  <section class="mt-8 lg:mt-12">
    <div class="flex items-baseline justify-between">
      <h2 class="text-xl font-semibold">Species</h2>
      <a href="/species" class="text-sm text-accent hover:underline">All {species.length} →</a>
    </div>
    <ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        species.slice(0, 6).map((entry) => (
          <li>
            <a
              href={`/species/${entry.id}`}
              class="block h-full rounded-xl border border-line bg-surface p-4 transition hover:border-accent/50"
            >
              <h3 class="font-semibold">{entry.data.commonName}</h3>
              <p class="text-xs italic text-muted">{entry.data.scientificName}</p>
              <p class="mt-2 text-sm text-muted">
                {entry.data.difficulty ?? 'care undocumented'}
                {entry.data.temperament ? ` · ${entry.data.temperament}` : ''}
              </p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-8 lg:mt-12">
    <div class="flex items-baseline justify-between">
      <h2 class="text-xl font-semibold">Care guides</h2>
      <a href="/care" class="text-sm text-accent hover:underline">All {care.length} →</a>
    </div>
    <ul class="mt-4 grid gap-3 sm:grid-cols-2">
      {
        care.slice(0, 4).map((entry) => (
          <li>
            <a
              href={`/care/${entry.id}`}
              class="block h-full rounded-xl border border-line bg-surface p-4 transition hover:border-accent/50"
            >
              <h3 class="font-semibold">{entry.data.title}</h3>
              <p class="mt-1 text-sm text-muted">{entry.data.summary}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-12 rounded-xl border border-line bg-surface p-6">
    <h2 class="text-xl font-semibold">How the tracker works</h2>
    <div class="mt-4 grid gap-6 sm:grid-cols-3">
      <div>
        <h3 class="font-medium">Log feedings and molts</h3>
        <p class="mt-1 text-sm text-muted">
          Record what was offered and whether it was taken. Refusals matter as much as meals.
        </p>
      </div>
      <div>
        <h3 class="font-medium">Get a pre-molt warning</h3>
        <p class="mt-1 text-sm text-muted">
          A run of refused prey plus a sealed silk retreat is the classic tell. The app watches for
          it so you stop offering food at the right time.
        </p>
      </div>
      <div>
        <h3 class="font-medium">Stays on your device</h3>
        <p class="mt-1 text-sm text-muted">
          No account and no server. Download a backup file whenever you want a copy.
        </p>
      </div>
    </div>
  </section>
</Base>
