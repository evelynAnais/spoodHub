# Read natively by Cloudflare Workers static assets (and by Pages, which is
# now legacy). Copied from public/ into dist/ at build time.

# Astro's build assets carry a content hash in the filename, so they can be
# cached forever — a change produces a new filename.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# The service worker must never be served stale, or a browser can be pinned to
# an old caching strategy indefinitely.
/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: public, max-age=3600

/*
  # The Content-Security-Policy itself is generated by Astro (see `security.csp`
  # in astro.config.mjs) and delivered as a <meta> tag, because it has to carry
  # integrity hashes for Astro's own inline scripts. Declaring a second CSP here
  # would combine restrictively with that one and block them.
  #
  # This directive covers the one thing a meta tag cannot express — browsers
  # ignore frame-ancestors in meta, so it has to be a real header:
  Content-Security-Policy: frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # Nothing here needs a camera, microphone or location. NFC is deliberately
  # left enabled — the enclosure-tag writer uses it on Android Chrome.
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY
