# Cloudflare Pages reads this file.

# Astro's build assets carry a content hash in the filename, so they can be
# cached forever — a change produces a new filename.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# The service worker must never be served stale, or a browser can be pinned to
# an old caching strategy indefinitely.
/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: public, max-age=3600

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
